{
  "name": "CRM_GetCustomerByPhoneNumber_Array",
  "integrationType": "custom-rest-actions",
  "actionType": "custom",
  "config": {
    "request": {
      "requestUrlTemplate": "https://YOUR-SITE.netlify.app/api/v1/customers?phoneNumber=${input.phoneNumber}&industry=telco",
      "requestType": "GET",
      "headers": {},
      "requestTemplate": "${input.rawRequest}"
    },
    "response": {
      "translationMap": {},
      "translationMapDefaults": {},
      "successTemplate": "${rawResult}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "successSchema": {
        "title": "customers",
        "type": "array",
        "properties": {},
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "phoneNumber": {
              "type": "string"
            },
            "firstName": {
              "type": "string"
            },
            "accountNumber": {
              "type": "string"
            },
            "billAmount": {
              "type": "number"
            },
            "deviceType": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "secure": false
}
